// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("QA_LEAD")
  createdAt DateTime @default(now())

  uploadedFiles UploadedFile[]
}

model UploadedFile {
  id           String   @id @default(uuid())
  originalName String
  savedAs      String
  sizeInBytes  Int
  uploadedAt   DateTime @default(now())

  uploadedBy   SystemUser @relation(fields: [uploadedById], references: [id])
  uploadedById String

  failures     ParsedFailure[]
}

model ParsedFailure {
  id           String   @id @default(uuid())
  testId       String
  testName     String
  rawErrorLog  String
  category     String
  severity     String
  cleanSummary String
  createdAt    DateTime @default(now())

  sourceFile   UploadedFile @relation(fields: [sourceFileId], references: [id])
  sourceFileId String
}